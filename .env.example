# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional for external PHP/Node hosting if Google API needs a custom proxy or mirror base URL:
# GEMINI_API_BASE="https://generativelanguage.googleapis.com"
# GEMINI_PROXY_URL="http://user:pass@proxy-host:3128"

# Optional owner passphrase to unlock free-topic chat mode in preview chat (also supports /unlock <code-word>):
# PREVIEW_UNLOCK_CODE="gk-cyber-9472-unlock"

# Optional secret passphrase to reveal the hidden multi-user Live Voice test channel in preview chat (also supports /voice <code-word>):
# PREVIEW_VOICE_UNLOCK_CODE="gk-voice-7714-test"

# Optional WebRTC TURN relay credentials for strict corporate/mobile NATs:
# TURN_URLS="turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349"
# TURN_USERNAME="my-turn-user"
# TURN_CREDENTIAL="my-turn-password"

# Note for REG.RU Host-0 (PHP + SQLite/MySQL):
# Copy dist/api/config.example.php -> dist/api/config.php on the hosting server to configure
# MySQL credentials, Gemini API key, feedback email, or custom TURN servers.

